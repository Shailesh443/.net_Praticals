<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Feedback Management</title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
        }

        header {
            background-color: #333;
            color: white;
            padding: 15px;
        }

        nav a {
            color: white;
            margin-right: 20px;
            text-decoration: none;
        }

        main {
            padding: 30px;
        }

        footer {
            background-color: #eee;
            padding: 15px;
            text-align: center;
        }
    </style>
</head>

<body>

    <header>
        <h2>Feedback Management System</h2>

        <nav>
            <a href="@Url.Action("Index", "Home")">Home</a>
            <a href="@Url.Action("Index", "Feedback")">Feedback</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>© 2026 Feedback Management System</p>
    </footer>

</body>
</html>